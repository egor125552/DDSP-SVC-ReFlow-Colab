FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    git ffmpeg libsndfile1 curl unzip build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel
RUN pip install torch==2.9.1 torchaudio==2.9.1 --index-url https://download.pytorch.org/whl/cpu

ARG DDSP_SVC_COMMIT=3635301027473c6662d05a1c73ef34fba7f15f90
RUN mkdir -p /workspace/DDSP-SVC \
    && git -C /workspace/DDSP-SVC init -q \
    && git -C /workspace/DDSP-SVC remote add origin https://github.com/yxlllc/DDSP-SVC.git \
    && git -C /workspace/DDSP-SVC fetch -q --depth 1 origin "${DDSP_SVC_COMMIT}" \
    && git -C /workspace/DDSP-SVC checkout -q --detach FETCH_HEAD
WORKDIR /workspace/DDSP-SVC
RUN pip install -r requirements.txt
RUN pip install setuptools==80.9.0
RUN pip install "gradio>=5.0,<7"

COPY scripts /workspace/tools
COPY colab_app.py /workspace/tools/colab_app.py
RUN chmod +x /workspace/tools/*.sh

CMD ["bash"]
